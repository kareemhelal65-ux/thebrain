# Ignore everything by default
*

# Whitelist Git/metadata files at root
!.gitignore
!README.md

# Whitelist marketing website assets/scripts/html
!index.html
!style.css
!canvas-bg.js
!privacy.html
!terms.html
!refund.html

# Whitelist marketing asset directories
!marketing assets/
!marketing assets/**
!assets/
!assets/**
!marketing-site/
!marketing-site/**

!main.js
!styles.css
